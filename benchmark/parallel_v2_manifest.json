{
  "schema_version": 1,
  "title": "DSM parallel architecture v2 evaluation",
  "as_of": "2026-07-29",
  "description": "Controlled comparison of the frozen root-task CPU scheduler, the current root scheduler, the bounded dynamic-prefix scheduler, the frozen level-synchronous GPU frontier, the current level implementation, and the resident-continuation GPU executor.",
  "repeats": 5,
  "timeout_seconds": 300,
  "methodology": {
    "primary_metric": "Median cold-process end-to-end time over isolated, interleaved runs.",
    "cpu_affinity": "Physical cores are assigned first: 1T=0, 2T=0,2, ..., 16T=even CPUs 0..30; 32T=all logical CPUs.",
    "performance_instrumentation": "Performance rows use --statistics off and --result-digest off. CPU scheduler load-balance counters remain always-on and are reported separately.",
    "correctness": "Correctness rows require stable count and order-independent mapping digest; synthetic cases additionally use a known match-count oracle.",
    "scheduler_boundary": "The intended-selectivity skew cases isolate a one-hot-root scheduler bottleneck. The paper-selectivity case is a negative control because its selected leaf root already distributes the hot center.",
    "gpu_boundary": "GPU headline comparisons use end-to-end time. Kernel, GPU-ready, launch/synchronization, and per-depth metrics are diagnostics. No CPU fallback is allowed.",
    "comparison_boundary": "All scheduler and GPU-structure speedups are computed only within the same case, selectivity, order, memo, statistics, k, seed, and input/query hashes."
  },
