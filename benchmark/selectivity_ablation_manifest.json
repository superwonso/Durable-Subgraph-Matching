{
  "schema_version": 1,
  "title": "Selectivity, candidate-volume, pruning, and GPU-memory ablations",
  "as_of": "2026-07-29",
  "description": "Controlled ablations for Original (TD-Tree), Ours, Ours+Gopher CPU, and Ours+Gopher-GPU. A full-raw-file suite isolates Selectivity candidate volume on all four datasets; the earlier 5% raw-derived rows remain a resource-bounded timing supplement.",
  "repeats": 5,
  "timeout_seconds": 900,
  "methodology": {
    "primary_metric": "Median cold-process end-to-end wall time over five isolated, interleaved repetitions.",
    "td_tree_baseline": "Original is the TD-Tree baseline. Cross-engine rows always pass --duration-mode consecutive; the unsupported --selectivity option is never passed to Original.",
    "selectivity_factor": "Ours is evaluated with tdtree (|V_L|/degree), paper (degree/(|V_L|*A_dur)), and intended (|V_L|/(degree*A_dur)) root scores.",
    "full_raw_selectivity_boundary": "The primary Selectivity candidate-count cohort passes the same supplied non-_filtered full raw file to all three Ours modes, holds the consecutive-pair prefilter on, and changes only the root-score definition. One repetition is sufficient for deterministic candidate counters; its wall time is diagnostic, not a repeated timing estimate.",
    "prefilter_factor": "Ours is evaluated with its consecutive-pair edge-history prefilter both off and on. Original retains all directed edge histories and is therefore the prefilter-off TD-Tree reference.",
    "candidate_metrics": "root_candidate_count, raw_extension_candidates, and accepted_extensions are common search-volume counters. candidate_relation_entries measures built relation size. CPU Gopher generated_candidates is a post-structural counter and must not be compared directly with the GPU legacy generated_candidates field.",
    "statistics_boundary": "Ours and Original collect their lightweight aggregated counters in the CPU32 rows. Gopher performance rows use --statistics off; separate one-repeat CPU1 and GPU diagnostic rows use --statistics on for candidate-volume analysis.",
    "pruning_factor": "The early-pruning study holds data, query, selectivity=paper, order=paper, memo=none, label seed, scheduler or GPU variant, and memory cap fixed within each cohort.",
    "gpu_memory_factor": "The GPU memory study holds resident execution, early-prune=on, selectivity=paper, order=paper, memo=none, and statistics=off fixed while varying only --gpu-memory-mb.",
    "cpu_affinity": "CPU32 rows are pinned to logical CPUs 0-31. CPU1 and GPU host-control rows are pinned to logical CPU 0.",
    "correctness": "Every algorithm in a case must finish every repetition, remain count-stable, and match the nonzero expected_match_count oracle.",
    "output_mode": "All rows use count-only output. A positive Count is still recorded; only per-mapping materialization is suppressed.",
    "provenance": "The runner records SHA-256 hashes for executables, datasets, queries, and the used manifest."
  },
  "factor_definitions": {
    "selectivity": [
      "tdtree",
      "paper",
      "intended"
    ],
    "prefilter": [
      "off",
      "on"
    ],
    "early_prune": [
      "off",
      "on"
    ],
    "k": [
      3,
      4,
      5
    ],
    "gpu_memory_mb": [
      32,
      64,
      128,
      256,
      1024,
      4096
    ]
  },
  "dataset_inventory": [
    {
      "id": "sx_superuser_raw",
      "path": "{root}/Dataset/sx-superuser-temporal-1w-unique.txt",
      "input_variant": "raw_unique_occurrences"
    },
    {
      "id": "wiki_talk_raw",
      "path": "{root}/Dataset/wiki-talk-temporal-timeinstance-unique-1w.txt",
      "input_variant": "raw_unique_occurrences"
    },
    {
